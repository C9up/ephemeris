{
  "name": "@c9up/ephemeris",
  "version": "0.1.0",
  "description": "Ephemeris — schema.org structured data for the Ream ecosystem: the whole vocabulary typed, an @graph of linked entities, JSON-LD that cannot break out of its script tag, and Google's rich-result requirements checked",
  "license": "MIT AND CC-BY-SA-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:schema": "node scripts/generate-schema.ts",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/ephemeris.git"
  }
}
